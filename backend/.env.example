# Required — the API key clients must send as the X-API-Key header
API_KEY=

# Optional — comma-separated list of allowed origins for CORS, or "*" (default)
CORS_ALLOW_ORIGINS=*

# Search backends — web_search() uses ALL that are configured, not just one.
# Falls back to unauthenticated Bing scraping if none are set.
TAVILY_API_KEY=
SERP_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# Optional — better scraping for JS-heavy pages (falls back to BeautifulSoup)
FIRECRAWL_API_KEY=

# Optional — directories lane (10times via Apify). Both must be set to
# activate; leave blank to keep this lane dormant.
APIFY_API_TOKEN=
CFP_DIRECTORY_APIFY_ACTOR_ID=zen-studio~10times-events-scraper

# Optional — total spend cap (USD) for the directories lane, per scout run
CFP_DIRECTORY_APIFY_MAX_CHARGE_USD=1.00
